# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Nunca coloque essas chaves no código.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-ou-anon

# Endereço público do site (usado nos links enviados por e-mail).
# Local: http://localhost:3000 · Vercel: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave SECRETA (service role / secret key). Só no servidor: grava os
# pedidos do formulário público. Nunca use NEXT_PUBLIC_ nesta chave.
SUPABASE_SECRET_KEY=sua-chave-secreta

# Seu WhatsApp (só dígitos, com 55 + DDD). O cliente é levado para cá
# depois de mandar o pedido pelo site.
NEXT_PUBLIC_WHATSAPP_TATUADOR=5571999999999
